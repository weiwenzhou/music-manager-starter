@page "/playlist/{id}"
@using music_manager_starter.Shared.Models

@inject HttpClient Http
@inject NavigationManager NavigationManager

@code {
    [Parameter] public string id { get; set; } = string.Empty;
    private Playlist playlist = new Playlist();
    private bool showAddSongForm = false;
    private bool showDeleteSongConfirmation = false;
    private bool showDeletePlaylistConfirmation = false;
    private Guid selectedSongId = Guid.Empty;
    private List<Song> availableSongs = new List<Song>();
    private string songTitleToDelete = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        playlist = await Http.GetFromJsonAsync<Playlist>($"api/playlists/{id}") ?? new Playlist();

        // Fetch list of available songs
        availableSongs = await Http.GetFromJsonAsync<List<Song>>("api/songs") ?? new List<Song>();
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/playlists");
    }

    private async Task AddSongFromAvailable()
    {
        if (selectedSongId == Guid.Empty)
        {
            return;
        }
        var response = await Http.PostAsync($"api/playlists/{playlist.Id}/songs/{selectedSongId}", null);
        if (response.IsSuccessStatusCode)
        {
            playlist = await Http.GetFromJsonAsync<Playlist>($"api/playlists/{id}") ?? new Playlist();
            selectedSongId = Guid.Empty;
            showAddSongForm = false;
        }
    }

	private void CancelAdd()
	{
		selectedSongId = Guid.Empty;
		showAddSongForm = false;
	}

    private async Task RemoveSongFromPlaylist()
    {
        var response = await Http.DeleteAsync($"api/playlists/{playlist.Id}/songs/{selectedSongId}");
        if (response.IsSuccessStatusCode)
        {
            playlist = await Http.GetFromJsonAsync<Playlist>($"api/playlists/{id}") ?? new Playlist();

            CancelDelete();

        }
    }

	private void ShowDeleteConfirmationWindow(Guid songId, string songTitle)
	{
        songTitleToDelete = songTitle;
        selectedSongId = songId;
		showDeleteSongConfirmation = true;
	}

	private void CancelDelete()
	{
		showDeleteSongConfirmation = false;
		selectedSongId = Guid.Empty;
		songTitleToDelete = string.Empty;
	}

    private async Task DeletePlaylist()
    {
        var response = await Http.DeleteAsync($"api/playlists/{playlist.Id}");
        if (response.IsSuccessStatusCode)
        {
            NavigationManager.NavigateTo("/playlists");
        }
    }
}

<div class="p-6 text-white">
	<button class="px-4 py-2 bg-gray-600 hover:bg-gray-500 text-white rounded-lg mb-4" @onclick="GoBack">
		← Back
	</button>
    <div class="flex justify-between text-xl mb-2">
	    <h1 class="text-4xl font-semibold">@playlist?.Title</h1>
        <button @onclick="() => showDeletePlaylistConfirmation = true" class="mt-6 px-4 py-2 bg-red-600 text-white rounded-lg">
            Delete Playlist
        </button>
    </div>
	<p class="text-xl text-gray-300 mt-2">Description: @playlist?.Description</p>

    <div class="mt-6">
        <div class="flex justify-between text-xl mb-2">
            <h2 class="text-2xl font-semibold text-gray-200">Songs in this Playlist</h2>
            <button @onclick="() => showAddSongForm = true" class="px-4 bg-blue-600 hover:bg-blue-500 text-white rounded-lg">
                Add Song from Available Songs
            </button>
        </div>

        @if (showAddSongForm)
        {
            <div class="fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center z-50">
                <div class="bg-gray-800 p-6 rounded-lg max-w-sm w-full">
                    <h2 class="text-2xl font-semibold text-gray-200">Select Song to Add</h2>
                    <div class="mt-4">
                        <label for="songSelect" class="text-gray-300">Choose a Song</label>
                        <select id="songSelect" class="mt-1 block w-full p-2 border rounded text-black" @bind="selectedSongId">
                            <option value="">-- Select a Song --</option>
                            @foreach (var song in availableSongs.Where(song => !(playlist?.Songs ?? new List<Song>()).Any(s => s.Id == song.Id)))
                            {
                                <option value="@song.Id">@song.Title - @song.Artist</option>
                            }
                        </select>
                    </div>

                    <button @onclick="AddSongFromAvailable" class="mt-4 bg-green-600 text-white px-4 py-2 rounded">Add Selected Song</button>
                    <button @onclick="CancelAdd" class="mt-4 ml-2 bg-gray-600 text-white px-4 py-2 rounded">Cancel</button>
                </div>
            </div>
        }


        @if (playlist?.Songs != null && playlist.Songs.Any())
        {
            <table class="w-full table-auto border-collapse border border-gray-200">
                <thead>
                    <tr class="bg-gray-800 border-b text-left text-white">
                        <th class="px-4 py-2"> Title </th>
                        <th class="px-4 py-2"> Artist </th>
                        <th class="px-4 py-2"> Album </th>
                        <th class="px-4 py-2"> Genre </th>
                        <th class="px-4 py-2"> Actions </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (song, index) in playlist.Songs.Select((song, i) => (song, i)))
                    {
                        <tr class="border-b hover:bg-gray-600 @(index % 2 == 0 ? "bg-gray-700" : "bg-gray-800")">
                            <td class="px-4 py-2 text-gray-200"><a href="/song/@song.Id" class="underline">@song.Title</a></td>
                            <td class="px-4 py-2 text-gray-200">@song.Artist</td>
                            <td class="px-4 py-2 text-gray-200">@song.Album</td>
                            <td class="px-4 py-2 text-gray-200">@song.Genre</td>
                            <td class="px-4 py-2 text-gray-200">
                                <button @onclick="() => ShowDeleteConfirmationWindow(song.Id, song.Title)" class="text-red-500 hover:text-red-400">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-gray-400">No songs in this playlist yet.</p>
        }
    </div>
</div>

@if (showDeleteSongConfirmation)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center z-50">
        <div class="bg-gray-800 p-6 rounded-lg max-w-sm w-full">
            <h2 class="text-2xl font-semibold text-gray-200">Confirm Deletion</h2>
            <p class="text-gray-300 mt-2">Are you sure you want to delete the song "<strong>@songTitleToDelete</strong>" from this playlist?</p>
            <div class="mt-4 flex justify-between">
                <button @onclick="RemoveSongFromPlaylist" class="bg-red-600 text-white px-4 py-2 rounded">Yes, Delete</button>
                <button @onclick="CancelDelete" class="bg-gray-600 text-white px-4 py-2 rounded">Cancel</button>
            </div>
        </div>
    </div>
}

@if (showDeletePlaylistConfirmation)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 flex justify-center items-center z-50">
        <div class="bg-gray-800 p-6 rounded-lg max-w-sm w-full">
            <h2 class="text-2xl font-semibold text-gray-200">Confirm Deletion</h2>
            <p class="text-gray-300 mt-2">Are you sure you want to delete this playlist?</p>
            <div class="mt-4 flex justify-between">
                <button @onclick="DeletePlaylist" class="bg-red-600 text-white px-4 py-2 rounded">Yes, Delete Playlist</button>
                <button @onclick="() => showDeletePlaylistConfirmation = false" class="bg-gray-600 text-white px-4 py-2 rounded">Cancel</button>
            </div>
        </div>
    </div>
}