@page "/song/{id}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using music_manager_starter.Shared.Models

@code {
    [Parameter] public string id { get; set; } = string.Empty;
    private Song song = new Song();
    private string? albumImage;
    private bool isDeleting = false; // Prevent multiple delete requests
	private bool showDeleteConfirmation = false;

    protected override async Task OnInitializedAsync()
    {
        song = await Http.GetFromJsonAsync<Song>($"api/songs/{id}") ?? new Song();

        if (song?.AlbumArt != null)
        {
            albumImage = $"data:{song.AlbumArtContentType};base64,{Convert.ToBase64String(song.AlbumArt)}";
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }

    private async Task DeleteSong()
    {
        isDeleting = true;
        var response = await Http.DeleteAsync($"api/songs/{id}");
        if (response.IsSuccessStatusCode)
        {
            GoBack();
        }
		else
		{
			isDeleting = false;
		}
	}
}

<div class="bg-gray-700 mt-8 p-6 pt-12 rounded-lg shadow-lg max-w-3xl mx-auto text-gray-100 relative">
    <button class="px-4 py-2 bg-gray-600 hover:bg-gray-500 text-white rounded-lg mb-4" @onclick="GoBack">
        ← Back
    </button>

    <div class="text-center">
        <h1 class="text-4xl font-semibold text-indigo-500">@song?.Title</h1>
        <p class="text-xl text-gray-300 mt-2">by @song?.Artist</p>

        <div class="mt-4">
		    @if (song?.AlbumArt != null)
		    {
			
			    <img src="@albumImage" alt="Album Cover" class="rounded-lg shadow-lg w-60 mx-auto" />
		    } 
            else 
            {
			    <p class="text-gray-400">No album art available.</p>
            }
        </div>
    </div>

    <div class="mt-8 space-y-4">
        <div class="flex justify-between text-xl">
            <span class="font-medium text-gray-300">Album:</span>
            <span class="text-gray-200">@song?.Album</span>
        </div>
        <div class="flex justify-between text-xl">
            <span class="font-medium text-gray-300">Genre:</span>
            <span class="text-gray-200">@song?.Genre</span>
        </div>
    </div>

    <div class="mt-6 flex justify-center">
        <button class="px-6 py-2 bg-red-600 hover:bg-red-500 text-white font-semibold rounded-lg"
                @onclick="() => showDeleteConfirmation = true" disabled="@isDeleting">
                @(isDeleting ? "Deleting..." : "Delete Song")
        </button>
    </div>

    @if (showDeleteConfirmation)
    {
        <div class="absolute inset-0 bg-black bg-opacity-50 flex justify-center items-center z-50">
            <div class="bg-gray-800 p-6 rounded-lg shadow-lg text-center max-w-lg w-full">
                <h2 class="text-xl text-white">Are you sure you want to delete this song?</h2>
                <div class="mt-4 space-x-4">
                    <button class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg" @onclick="DeleteSong">
                        Yes, Delete
                    </button>
                    <button class="px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white rounded-lg" @onclick="() => showDeleteConfirmation = false">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    }
</div>
