@page "/AddSong"
@inject HttpClient Http
@using music_manager_starter.Shared.Models


<div class="p-6">
    <h2 class="text-xl font-semibold text-white">Add New Song</h2>
    <EditForm Model="newSong" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />

        <div class="mb-4">
            <label class="block text-gray-200">Title</label>
            <InputText @bind-Value="newSong.Title" class="mt-1 block w-full p-2 border rounded" />
            <ValidationMessage For="@(() => newSong.Title)" class="validation-message text-red-500 font-semibold" />
        </div>

        <div class="mb-4">
            <label class="block text-gray-200">Artist</label>
            <InputText @bind-Value="newSong.Artist" class="mt-1 block w-full p-2 border rounded" />
            <ValidationMessage For="@(() => newSong.Artist)" class="validation-message text-red-500 font-semibold" />
        </div>

        <div class="mb-4">
            <label class="block text-gray-200">Album</label>
            <InputText @bind-Value="newSong.Album" class="mt-1 block w-full p-2 border rounded" />
            <ValidationMessage For="@(() => newSong.Album)" class="validation-message text-red-500 font-semibold" />
        </div>

        <div class="mb-4">
            <label class="block text-gray-200">Genre</label>
            <InputText @bind-Value="newSong.Genre" class="mt-1 block w-full p-2 border rounded" />
            <ValidationMessage For="@(() => newSong.Genre)" class="validation-message text-red-500 font-semibold" />
        </div>

        <div class="mb-4">
            <label class="block text-gray-200">Album Art</label>
            <InputFile OnChange="HandleFileSelected" class="mt-1 block w-full p-2 border rounded" />
        </div>

        @if (fileName != null)
        {
            <div class="mt-2">
                <p class="text-white">Uploaded: @fileName</p>
                <img src="@imagePreview" alt="Album Art Preview" class="mt-2 max-w-xs" />
            </div>
        }

        <button type="submit" class="bg-purple-600 text-white px-4 py-2 rounded">Add Song</button>
    </EditForm>

    @if (message != null)
    {
        <p class="mt-4 text-green-500">@message</p>
    }
</div>

@code {
    private Song newSong = new Song();
    private string message = string.Empty;
    private string? fileName;
    private string? imagePreview;

    private async Task HandleValidSubmit()
    {
        var response = await Http.PostAsJsonAsync("api/songs", newSong);
        if (response.IsSuccessStatusCode)
        {
            message = "Song added successfully!";
            newSong = new Song(); 
        }
        else
        {
            message = "Error adding song. Please try again.";
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null) {
            // Get the file name
            fileName = file.Name; 

            // Get the image preview
            var buffer = new byte[file.Size];
            await file.OpenReadStream().ReadAsync(buffer);

            // Set the byte array and content type to the new song
            newSong.AlbumArt = buffer;
            newSong.AlbumArtContentType = file.ContentType;

            // Create preview URL
			var base64 = Convert.ToBase64String(buffer);
			imagePreview = $"data:{file.ContentType};base64,{base64}";
        }
	}
}